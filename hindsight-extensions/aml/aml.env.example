# Textual / Industrial baseline agreed for this fork. Replace all credentials.
HINDSIGHT_API_HTTP_EXTENSION=hindsight_api.extensions.builtin.aml:AmlHttpExtension
HINDSIGHT_API_HTTP_AML_API_KEY=replace-with-evaluation-key
HINDSIGHT_API_HTTP_AML_NAMESPACE=aml-textual-v1
HINDSIGHT_API_HTTP_AML_ADD_TIMEOUT=1770
HINDSIGHT_API_HTTP_AML_POLL_INTERVAL=0.5
HINDSIGHT_API_HTTP_AML_SEARCH_BUDGET=high
HINDSIGHT_API_HTTP_AML_SEARCH_MAX_TOKENS=8192

# Protect native API routes as well; use the SAME evaluation key in both fields.
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY=replace-with-evaluation-key
HINDSIGHT_API_OPERATION_RETENTION_DAYS=0
HINDSIGHT_API_WORKER_ENABLED=true
HINDSIGHT_API_RETAIN_BATCH_ENABLED=false
HINDSIGHT_API_FAIL_ON_EXTRACTION_ERRORS=true

HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_LLM_API_KEY=replace-with-llm-provider-key
HINDSIGHT_API_RETAIN_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_CONSOLIDATION_LLM_MODEL=gpt-4o-mini

# Verify the compatible endpoint, output dimensions and quota before Full.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-v4
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=replace-with-embedding-provider-key
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://replace-with-embedding-endpoint.example/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_BATCH_SIZE=10

# Reranker is intentionally inherited from the deployment, not changed here.
# Configure persistent PostgreSQL in production; otherwise embedded pg0 is used.
# HINDSIGHT_API_DATABASE_URL=postgresql://user:password@db:5432/hindsight
